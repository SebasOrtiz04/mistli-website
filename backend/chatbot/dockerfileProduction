FROM python:3.12-slim

# Evita archivos .pyc y fuerza logs inmediatos
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias del sistema necesarias para Google Auth
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias primero para aprovechar cache
COPY ./backend/chatbot/requirements.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copiar aplicación
COPY ./backend/chatbot/app ./app

# NO copiar:
# .env
# credentials.json
# token.json

EXPOSE 11343

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "11343"]